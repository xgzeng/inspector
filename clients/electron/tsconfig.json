{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./build",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  // Tests live in `__tests__/` (typechecked via tsconfig.test.json) so the
  // emitting build never compiles one into `build/`, which the packaged app
  // ships. Mirrors clients/launcher.
  "exclude": ["node_modules", "build", "**/*.test.*"]
}
